# ==============================================================================
# FlashTopup Reseller API Configuration (Backend & Secrets)
# IMPORTANT: Ne jamais inscrire de véritables clés secrètes dans le code source.
# Ces variables sont des exemples fictifs pour guider le déploiement sécurisé.
# ==============================================================================

# URL de base officielle de l'API Revendeur FlashTopup
# Exemples:
# Sandbox: https://sandbox.flashtopup.com/api/v1
# Production: https://api.flashtopup.com/api/v1
FLASH_TOPUP_API_BASE_URL="https://api.flashtopup.com/api/v1"

# Identifiant revendeur ou compte assigné par FlashTopup (si requis par le fournisseur)
FLASH_TOPUP_RESELLER_ID="reseller_demo_98765"

# Clé API privée (API Key) du compte revendeur FlashTopup
FLASH_TOPUP_API_KEY="ft_live_sk_example_a1b2c3d4e5f67890123456789abcdef0"

# Secret d'API / Signature (si signature cryptographique requise)
FLASH_TOPUP_API_SECRET="sec_demo_f4c92a71e830b5e69d71c42f0198a2e4"

# Secret partagé pour la validation cryptographique des signatures Webhook
# Utilisé pour vérifier le hash HMAC-SHA256 envoyé dans les en-têtes (ex: X-Signature)
FLASH_TOPUP_WEBHOOK_SECRET="whsec_demo_8e7f1b2c3d4a5960718293a4b5c6d7e8"

# URL publique de notification Webhook de TopZyn (Cloud Function ou Cloud Run)
FLASH_TOPUP_WEBHOOK_URL="https://us-central1-topzyn-prod.cloudfunctions.net/flashtopupWebhook"

# Environnement d'exécution ('sandbox' ou 'production')
FLASH_TOPUP_ENVIRONMENT="production"
